---
// src/components/Hero.astro
---

<section class="hero">

  <div class="wash"></div>
  <canvas id="waves"></canvas>
  <div class="scrim"></div>

  <div class="blob b1"></div>
  <div class="blob b2"></div>

  <div class="content">

    <div class="eyebrow-dot">
      Engineering · Human-centered · Innovation
    </div>

    <h1>
      Creating <span class="grad">Systems</span> for Humanity
    </h1>

    <p class="sub">
      Lingaasys builds intelligent engineering systems that put people first —
      turning complex problems into premium, human-centered solutions.
    </p>

    <div class="cta-row">
      <a class="btn btn-primary" href="/about">
        Explore Lingaasys
      </a>

      <a class="btn btn-ghost" href="/contact">
        Talk to us
      </a>
    </div>

  </div>

</section>


<style>

  .hero {
    --bg: #F6F6F7;
    --bg-deep: #E7E7EA;
    --surface: #FFFFFF;

    --ink: #26272B;
    --ink-soft: #63656C;

    --orange: #FF6A1A;
    --orange-2: #FF8F3D;
    --yellow: #FFC23D;

    --glow: rgba(255, 106, 26, 0.55);

    position: relative;

    min-height: 100vh;
    min-height: 100svh;

    display: flex;
    align-items: center;
    justify-content: center;

    color: var(--ink);

    background:
      radial-gradient(
        1100px 600px at 82% 8%,
        rgba(255, 140, 50, 0.16),
        transparent 60%
      ),
      radial-gradient(
        900px 500px at 10% 95%,
        rgba(255, 194, 61, 0.14),
        transparent 60%
      ),
      linear-gradient(
        180deg,
        var(--bg) 0%,
        var(--bg-deep) 100%
      );

    overflow: hidden;
  }

  .hero * {
    box-sizing: border-box;
  }


  /* =========================
     MOVING WASH
     ========================= */

  .wash {
    position: absolute;
    inset: -20%;

    background:
      conic-gradient(
        from 0deg,
        rgba(255,106,26,0.10),
        rgba(255,194,61,0.08),
        rgba(255,106,26,0.10)
      );

    filter: blur(60px);

    animation: spin 22s linear infinite;

    z-index: 0;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }


  /* =========================
     WAVE CANVAS
     ========================= */

  #waves {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    z-index: 1;

    opacity: 0.6;

    pointer-events: none;
  }


  /* =========================
     CENTER SCRIM
     ========================= */

  .scrim {
    position: absolute;

    inset: 0;

    z-index: 2;

    pointer-events: none;

    background:
      radial-gradient(
        60% 55% at 50% 46%,
        rgba(246,246,247,0.92) 0%,
        rgba(246,246,247,0.72) 45%,
        rgba(246,246,247,0) 78%
      );
  }


  /* =========================
     GLOWING BLOBS
     ========================= */

  .blob {
    position: absolute;

    border-radius: 50%;

    filter: blur(70px);

    opacity: 0.55;

    z-index: 1;

    animation: breathe 7s ease-in-out infinite;
  }

  .b1 {
    width: 420px;
    height: 420px;

    top: -120px;
    right: -80px;

    background:
      radial-gradient(
        circle,
        var(--orange),
        transparent 70%
      );
  }

  .b2 {
    width: 360px;
    height: 360px;

    bottom: -140px;
    left: -100px;

    background:
      radial-gradient(
        circle,
        var(--yellow),
        transparent 70%
      );

    animation-delay: 2.2s;
  }

  @keyframes breathe {

    0%,
    100% {
      transform: scale(1);
      opacity: 0.45;
    }

    50% {
      transform: scale(1.18);
      opacity: 0.7;
    }

  }


  /* =========================
     CONTENT
     ========================= */

  .content {
    position: relative;

    z-index: 3;

    width: min(1100px, 90vw);

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 120px 24px;
  }


  /* =========================
     EYEBROW
     ========================= */

  .eyebrow-dot {
    display: inline-flex;

    align-items: center;

    gap: 10px;

    font-size: 14px;

    font-weight: 500;

    color: var(--ink-soft);

    margin-bottom: 28px;

    padding: 8px 18px;

    border-radius: 999px;

    background: rgba(255,255,255,0.7);

    border:
      1px solid rgba(38,39,43,0.08);

    box-shadow:
      0 4px 20px rgba(0,0,0,0.04);
  }

  .eyebrow-dot::before {
    content: '';

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background:
      linear-gradient(
        135deg,
        var(--orange),
        var(--yellow)
      );

    box-shadow:
      0 0 12px var(--glow);
  }


  /* =========================
     MAIN QUOTE
     ========================= */

  h1 {
    font-family:
      'Space Grotesk',
      system-ui,
      sans-serif;

    font-weight: 700;

    font-size:
      clamp(
        2.6rem,
        7vw,
        6.2rem
      );

    line-height: 1.03;

    letter-spacing: -0.02em;

    margin: 0 0 28px;

    max-width: 16ch;

    color: var(--ink);
  }


  /* =========================
     SYSTEMS GRADIENT
     ========================= */

  .grad {
    background:
      linear-gradient(
        100deg,
        var(--orange) 10%,
        var(--orange-2) 45%,
        var(--yellow) 85%
      );

    -webkit-background-clip: text;

    background-clip: text;

    color: transparent;

    background-size: 220% 100%;

    animation:
      shine 6s ease-in-out infinite;
  }

  @keyframes shine {

    0%,
    100% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }

  }


  /* =========================
     DESCRIPTION
     ========================= */

  .sub {
    font-size:
      clamp(
        1.05rem,
        1.6vw,
        1.3rem
      );

    color: var(--ink-soft);

    max-width: 46ch;

    line-height: 1.6;

    margin: 0 0 44px;
  }


  /* =========================
     BUTTONS
     ========================= */

  .cta-row {
    display: flex;

    gap: 16px;

    flex-wrap: wrap;

    justify-content: center;
  }

  .btn {
    font-weight: 600;

    font-size: 15px;

    padding: 16px 32px;

    border-radius: 999px;

    text-decoration: none;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    transition:
      transform .25s ease,
      box-shadow .25s ease,
      border-color .25s ease;
  }

  .btn-primary {
    color: #fff;

    background:
      linear-gradient(
        120deg,
        var(--orange),
        var(--orange-2) 60%,
        var(--yellow)
      );

    box-shadow:
      0 12px 32px rgba(255,106,26,0.38),
      0 0 0 1px rgba(255,255,255,0.15) inset;
  }

  .btn-primary:hover {
    transform: translateY(-2px);

    box-shadow:
      0 16px 40px rgba(255,106,26,0.5);
  }

  .btn-ghost {
    color: var(--ink);

    background: var(--surface);

    border:
      1.5px solid rgba(38,39,43,0.14);
  }

  .btn-ghost:hover {
    transform: translateY(-2px);

    border-color: var(--ink);
  }


  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 600px) {

    .content {
      width: calc(100% - 30px);

      padding: 100px 15px;
    }

    .eyebrow-dot {
      font-size: 12px;

      padding: 7px 14px;
    }

    h1 {
      font-size:
        clamp(
          2.8rem,
          14vw,
          4.5rem
        );
    }

    .sub {
      font-size: 15px;

      line-height: 1.7;
    }

    .cta-row {
      flex-direction: column;

      width: 100%;

      align-items: center;
    }

    .btn {
      width: 210px;

      justify-content: center;
    }

    .b1 {
      width: 280px;
      height: 280px;
    }

    .b2 {
      width: 250px;
      height: 250px;
    }

  }


  /* =========================
     REDUCED MOTION
     ========================= */

  @media (prefers-reduced-motion: reduce) {

    .wash,
    .blob,
    .grad {
      animation: none;
    }

    #waves {
      display: none;
    }

  }

</style>


<script>

  /* =========================
     CANVAS SETUP
     ========================= */

  const canvas =
    document.getElementById('waves');

  const reduce =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;


  if (canvas && !reduce) {

    const ctx =
      canvas.getContext('2d');

    if (!ctx) {
      throw new Error(
        'Canvas context unavailable'
      );
    }


    let W = 0;
    let H = 0;


    /* =========================
       RESIZE
       ========================= */

    function resize() {

      const dpr =
        Math.min(
          window.devicePixelRatio || 1,
          2
        );

      W = canvas.offsetWidth;
      H = canvas.offsetHeight;

      canvas.width =
        W * dpr;

      canvas.height =
        H * dpr;

      ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
      );

    }


    window.addEventListener(
      'resize',
      resize
    );

    resize();


    /* =========================
       WAVES
       ========================= */

    const waves = [

      {
        amp: 55,
        freq: 1.3,

        /* FAST */
        speed: 1.2,

        yBase: 0.22,
        width: 2.2,

        colorA: '#FF6A1A',
        colorB: '#FFC23D',

        glow: true
      },


      {
        amp: 70,
        freq: 0.9,

        /* FAST */
        speed: 0.85,

        yBase: 0.50,
        width: 1.8,

        colorA: '#FF8F3D',
        colorB: '#FFC23D',

        glow: true
      },


      {
        amp: 55,
        freq: 1.7,

        /* FASTEST */
        speed: 1.5,

        yBase: 0.84,
        width: 1.6,

        colorA: '#FF6A1A',
        colorB: '#FF8F3D',

        glow: false
      }

    ];


    /* =========================
       WAVE POSITION
       ========================= */

    function waveY(
      wave,
      x,
      t
    ) {

      const k =
        (
          wave.freq *
          Math.PI *
          2
        ) / W;


      return (

        wave.yBase * H

        +

        Math.sin(
          x * k +
          t * wave.speed
        ) * wave.amp

        +

        Math.sin(
          x * k * 0.5 -
          t * wave.speed * 0.7
        )
        *
        wave.amp
        *
        0.35

      );

    }


    /* =========================
       PARTICLES
       ========================= */

    const PER_WAVE = 22;


    const SHAPES = [
      'node',
      'diamond',
      'square',
      'ring'
    ];


    const particles =
      waves.flatMap(
        (_, wi) =>

          Array.from(
            {
              length: PER_WAVE
            },

            () => ({

              wave: wi,

              t:
                Math.random(),

              speed:
                0.00032 +
                Math.random() *
                0.00042,

              size:
                2.6 +
                Math.random() *
                2.4,

              flicker:
                Math.random() *
                Math.PI *
                2,

              shape:
                SHAPES[
                  Math.floor(
                    Math.random() *
                    SHAPES.length
                  )
                ],

              spin:
                Math.random() *
                Math.PI *
                2

            })

          )

      );


    /* =========================
       TECH NODE
       ========================= */

    function drawTechNode(
      x,
      y,
      r,
      shape,
      color,
      spin
    ) {

      ctx.save();

      ctx.translate(
        x,
        y
      );

      ctx.rotate(
        spin
      );

      ctx.strokeStyle =
        color;

      ctx.fillStyle =
        color;

      ctx.lineWidth =
        Math.max(
          0.8,
          r * 0.22
        );


      /* NODE */

      if (shape === 'node') {

        ctx.beginPath();

        ctx.arc(
          0,
          0,
          r,
          0,
          Math.PI * 2
        );

        ctx.fill();


        ctx.globalAlpha =
          0.5;

        ctx.beginPath();

        ctx.arc(
          0,
          0,
          r * 2.2,
          0,
          Math.PI * 2
        );

        ctx.stroke();

      }


      /* DIAMOND */

      else if (
        shape === 'diamond'
      ) {

        ctx.beginPath();

        ctx.moveTo(
          0,
          -r * 1.5
        );

        ctx.lineTo(
          r * 1.5,
          0
        );

        ctx.lineTo(
          0,
          r * 1.5
        );

        ctx.lineTo(
          -r * 1.5,
          0
        );

        ctx.closePath();

        ctx.fill();

      }


      /* SQUARE */

      else if (
        shape === 'square'
      ) {

        ctx.globalAlpha =
          0.85;

        ctx.fillRect(
          -r,
          -r,
          r * 2,
          r * 2
        );

        ctx.globalAlpha =
          1;

        ctx.strokeStyle =
          'rgba(255,255,255,0.8)';

        ctx.lineWidth =
          0.6;

        ctx.strokeRect(
          -r,
          -r,
          r * 2,
          r * 2
        );

      }


      /* RING */

      else {

        ctx.lineWidth =
          r * 0.5;

        ctx.beginPath();

        ctx.arc(
          0,
          0,
          r * 1.6,
          0,
          Math.PI * 2
        );

        ctx.stroke();


        ctx.beginPath();

        ctx.arc(
          0,
          0,
          r * 0.5,
          0,
          Math.PI * 2
        );

        ctx.fill();

      }


      ctx.restore();

    }


    /* =========================
       ANIMATION
       ========================= */

    let time = 0;


    function draw() {

      time += 1;


      ctx.clearRect(
        0,
        0,
        W,
        H
      );


      /* =====================
         DRAW WAVES
         ===================== */

      for (
        const wave of waves
      ) {

        ctx.beginPath();


        for (
          let x = 0;
          x <= W;
          x += 8
        ) {

          const y =
            waveY(
              wave,
              x,
              time * 0.045
            );


          if (x === 0) {

            ctx.moveTo(
              x,
              y
            );

          } else {

            ctx.lineTo(
              x,
              y
            );

          }

        }


        /* GRADIENT */

        const grad =
          ctx.createLinearGradient(
            0,
            0,
            W,
            0
          );


        grad.addColorStop(
          0,
          wave.colorA + 'AA'
        );

        grad.addColorStop(
          0.5,
          wave.colorB + 'CC'
        );

        grad.addColorStop(
          1,
          wave.colorA + 'AA'
        );


        ctx.strokeStyle =
          grad;

        ctx.lineWidth =
          wave.width;

        ctx.shadowColor =
          wave.colorA;

        ctx.shadowBlur =
          wave.glow
            ? 18
            : 0;

        ctx.stroke();

      }


      /* =====================
         DRAW PARTICLES
         ===================== */

      for (
        const p of particles
      ) {

        const wave =
          waves[p.wave];


        p.t +=
          p.speed;


        if (p.t > 1) {

          p.t -= 1;

        }


        p.spin +=
          0.01;


        const x =
          p.t * W;


        const y =
          waveY(
            wave,
            x,
            time * 0.045
          );


        const r =
          p.size *
          (
            0.65 +
            0.35 *
            Math.sin(
              time * 0.05 +
              p.flicker
            )
          );


        /* PARTICLE GLOW */

        const g =
          ctx.createRadialGradient(
            x,
            y,
            0,
            x,
            y,
            r * 5
          );


        g.addColorStop(
          0,
          wave.colorB + '55'
        );

        g.addColorStop(
          1,
          'rgba(255,140,50,0)'
        );


        ctx.shadowBlur = 0;

        ctx.fillStyle =
          g;


        ctx.beginPath();

        ctx.arc(
          x,
          y,
          r * 5,
          0,
          Math.PI * 2
        );

        ctx.fill();


        /* TECH NODE */

        ctx.shadowColor =
          wave.colorA;

        ctx.shadowBlur = 8;


        drawTechNode(
          x,
          y,
          r,
          p.shape,
          wave.colorB,
          p.spin
        );


        ctx.shadowBlur = 0;

      }


      requestAnimationFrame(
        draw
      );

    }


    requestAnimationFrame(
      draw
    );

  }

</script>