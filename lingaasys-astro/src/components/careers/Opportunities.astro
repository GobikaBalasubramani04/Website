---
import { supabase } from "../../lib/supabase";

interface Job {
  job_id: string;
  job_type: string;
  job_description: string;
  job_location: string | null;
  experience: string | null;
  qualifications: string[] | null;
  work_mode: string | null;
  responsibilities: string[] | null;
  skills: string[] | null;
  created_at: string;
}

const { data: jobs, error } = await supabase
  .from("jobs")
  .select("job_id, job_type, job_description, job_location, experience, qualifications, work_mode, responsibilities, skills, created_at")
  .in("job_type", ["Full Time", "Intern"])
  .order("created_at", { ascending: false });
---
<section class="opportunities">
  <div class="wrap">

    <div class="section-heading">
      <span class="eyebrow">OPPORTUNITIES</span>
      <h2>Available Opportunities</h2>
    </div>

    {error && (
      <p class="error-message">Something went wrong. Please try again later.</p>
    )}

    {!error && (!jobs || jobs.length === 0) && (
      <p class="no-jobs">No current openings available.</p>
    )}

    <div class="jobs-grid">
      {(jobs || []).map((job: Job) => (
        <article class="job-card" data-job-id={job.job_id}>
          <span class="job-type">{job.job_type}</span>
          <h3>{job.job_description}</h3>
          {job.job_location && <p class="job-location">{job.job_location}</p>}
          {job.experience && <p class="job-experience">{job.experience}</p>}

          <button
            class="show-more"
            type="button"
            data-target={job.job_id}
          >
            Show More <span>+</span>
          </button>

          <div class="job-details" id={job.job_id}>
            {job.job_description && (
              <div class="job-description">
                <span class="detail-label">JOB DESCRIPTION</span>
                <p>{job.job_description}</p>
              </div>
            )}

            {job.work_mode && (
              <div class="job-description">
                <span class="detail-label">WORK MODE</span>
                <p>{job.work_mode}</p>
              </div>
            )}

            {job.experience && (
              <div class="job-description">
                <span class="detail-label">EXPERIENCE</span>
                <p>{job.experience}</p>
              </div>
            )}

            {job.qualifications && job.qualifications.length > 0 && (
              <div class="job-description">
                <span class="detail-label">QUALIFICATIONS</span>
                <ul>
                  {job.qualifications.map((q: string) => (
                    <li>{q}</li>
                  ))}
                </ul>
              </div>
            )}

            {job.responsibilities && job.responsibilities.length > 0 && (
              <div class="job-description">
                <span class="detail-label">RESPONSIBILITIES</span>
                <ul>
                  {job.responsibilities.map((r: string) => (
                    <li>{r}</li>
                  ))}
                </ul>
              </div>
            )}

            {job.skills && job.skills.length > 0 && (
              <div class="job-description">
                <span class="detail-label">SKILLS</span>
                <ul>
                  {job.skills.map((s: string) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            )}

            <button
              class="apply-btn"
              type="button"
              data-apply={`apply-${job.job_id}`}
            >
              Apply Now <span>↗</span>
            </button>

            <div class="resume-section" id={`apply-${job.job_id}`}>
              <span class="detail-label">APPLICATION</span>
              <h4>Apply for {job.job_description}</h4>
              <p class="application-description">
                Upload your latest resume to continue with your application.
              </p>

              <label class="upload-box">
                <div class="upload-text">
                  <strong>Choose your resume</strong>
                  <small>PDF or DOCX</small>
                </div>
                <span class="browse-text">Browse</span>
                <input
                  class="resume-input"
                  type="file"
                  accept=".pdf,.docx"
                />
              </label>

              <p class="selected-file"></p>

              <div class="application-form">
                <span class="detail-label">APPLICATION DETAILS</span>
                <div class="form-grid">
                  <div class="form-field">
                    <label for={`name-${job.job_id}`}>Full Name</label>
                    <input
                      id={`name-${job.job_id}`}
                      type="text"
                      placeholder="Your full name"
                    />
                  </div>
                  <div class="form-field">
                    <label for={`email-${job.job_id}`}>Email</label>
                    <input
                      id={`email-${job.job_id}`}
                      type="email"
                      placeholder="you@example.com"
                    />
                  </div>
                  <div class="form-field">
                    <label for={`phone-${job.job_id}`}>Phone</label>
                    <input
                      id={`phone-${job.job_id}`}
                      type="tel"
                      placeholder="Your phone number"
                    />
                  </div>
                  <div class="form-field">
                    <label for={`role-${job.job_id}`}>Applying For</label>
                    <input
                      id={`role-${job.job_id}`}
                      type="text"
                      value={job.job_description}
                      readonly
                    />
                  </div>
                  <div class="form-field">
                    <label for={`linkedin-${job.job_id}`}>LinkedIn</label>
                    <input
                      id={`linkedin-${job.job_id}`}
                      type="url"
                      placeholder="LinkedIn profile URL"
                    />
                  </div>
                  <div class="form-field">
                    <label for={`portfolio-${job.job_id}`}>Portfolio</label>
                    <input
                      id={`portfolio-${job.job_id}`}
                      type="url"
                      placeholder="Portfolio URL"
                    />
                  </div>
                </div>
                <input
                  type="hidden"
                  name="job_id"
                  value={job.job_id}
                />

                <button class="submit-btn" type="button">
                  Submit Application <span>↗</span>
                </button>
                <p class="submit-message"></p>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .opportunities {
    padding: 110px 0 140px;
    background: #fff;
  }

  .section-heading {
    margin-bottom: 55px;
  }

  .section-heading h2 {
    margin: 15px 0 0;
    color: #171717;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .eyebrow {
    color: #f26a21;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .jobs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 30px;
  }

  .job-card {
    padding: 35px 0;
    border-top: 1px solid #ddd;
    border-bottom: 1px solid #ddd;
  }

  .job-type {
    color: #f26a21;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .job-card h3 {
    margin: 10px 0 10px;
    color: #171717;
    font-size: 24px;
    line-height: 1.2;
  }

  .job-location,
  .job-experience {
    color: #707070;
    font-size: 14px;
    line-height: 1.7;
    margin: 5px 0;
  }

  .show-more {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 12px 18px;
    border: 1px solid #d5d5d5;
    background: #fff;
    color: #171717;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s ease;
    margin-top: 20px;
  }

  .show-more:hover {
    border-color: #f26a21;
    color: #f26a21;
  }

  .show-more span {
    font-size: 18px;
    font-weight: 400;
  }

  .job-details {
    display: none;
    padding-top: 30px;
  }

  .job-details.active {
    display: block;
  }

  .job-description {
    max-width: 760px;
    margin-bottom: 25px;
  }

  .detail-label {
    display: block;
    margin-bottom: 10px;
    color: #f26a21;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .job-description p {
    margin: 0;
    color: #707070;
    font-size: 14px;
    line-height: 1.8;
  }

  .job-description ul {
    margin: 0;
    padding-left: 20px;
    color: #707070;
    font-size: 14px;
    line-height: 1.8;
  }

  .job-description ul li {
    margin-bottom: 5px;
  }

  .apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding: 14px 20px;
    border: 1px solid #f26a21;
    background: #f26a21;
    color: #fff;
    font-size: 12px;
    font-weight: 750;
    cursor: pointer;
    transition: all 0.25s ease;
    margin-top: 20px;
  }

  .apply-btn:hover {
    background: #171717;
    border-color: #171717;
  }

  .apply-btn span {
    font-size: 17px;
    font-weight: 400;
  }

  .resume-section {
    display: none;
    max-width: 820px;
    margin-top: 30px;
    padding: 32px;
    background: #f5f5f3;
    border: 1px solid #ddd;
  }

  .resume-section.active {
    display: block;
  }

  .resume-section h4 {
    margin: 0 0 8px;
    color: #171717;
    font-size: 24px;
  }

  .application-description {
    margin: 0 0 22px;
    color: #707070;
    font-size: 14px;
    line-height: 1.8;
  }

  .upload-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
    background: #fff;
    border: 1px dashed #bbb;
    color: #555;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .upload-box:hover {
    border-color: #f26a21;
    background: #fff;
  }

  .upload-text {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .upload-text strong {
    color: #171717;
    font-size: 14px;
  }

  .upload-text small {
    color: #888;
    font-size: 11px;
  }

  .browse-text {
    padding: 10px 16px;
    background: #171717;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
  }

  .upload-box input {
    display: none;
  }

  .selected-file {
    margin: 14px 0 0;
    color: #f26a21;
    font-size: 12px;
    font-weight: 700;
  }

  .application-form {
    display: none;
    margin-top: 35px;
    padding-top: 30px;
    border-top: 1px solid #ddd;
  }

  .application-form.active {
    display: block;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 25px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form-field label {
    color: #171717;
    font-size: 11px;
    font-weight: 700;
  }

  .form-field input {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 15px;
    border: 1px solid #d5d5d5;
    background: #fff;
    color: #171717;
    font-family: inherit;
    font-size: 13px;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .form-field input:focus {
    border-color: #f26a21;
    box-shadow: 0 0 0 3px rgba(242, 106, 33, 0.08);
  }

  .form-field input[readonly] {
    background: #eeeeec;
    color: #666;
    cursor: not-allowed;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    margin-top: 30px;
    padding: 14px 20px;
    border: 1px solid #171717;
    background: #171717;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.25s ease, border-color 0.25s ease;
  }

  .submit-btn:hover:not(:disabled) {
    background: #f26a21;
    border-color: #f26a21;
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-btn span {
    font-size: 16px;
  }

  .submit-message {
    margin: 15px 0 0;
    font-size: 13px;
    font-weight: 700;
  }

  .submit-message.success {
    color: #2f7d32;
  }

  .submit-message.error {
    color: #c0392b;
  }

  .error-message {
    color: #c0392b;
    font-size: 16px;
    margin-bottom: 20px;
  }

  .no-jobs {
    color: #707070;
    font-size: 18px;
    margin: 40px 0;
  }

  @media (max-width: 700px) {
    .wrap {
      width: calc(100% - 40px);
    }

    .opportunities {
      padding: 80px 0 100px;
    }

    .section-heading {
      margin-bottom: 40px;
    }

    .section-heading h2 {
      font-size: clamp(36px, 6vw, 48px);
    }

    .jobs-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .job-card {
      padding: 25px 0;
    }

    .job-card h3 {
      font-size: 20px;
    }

    .form-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .upload-box {
      align-items: flex-start;
      flex-direction: column;
    }

    .browse-text {
      width: 100%;
      box-sizing: border-box;
      text-align: center;
    }
  }
</style>

<script>
  /* SHOW MORE / SHOW LESS */
  document.querySelectorAll('.show-more').forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-target');
      const details = document.getElementById(target || '');
      if (!details) return;

      details.classList.toggle('active');

      if (details.classList.contains('active')) {
        button.innerHTML = 'Show Less <span>−</span>';
      } else {
        button.innerHTML = 'Show More <span>+</span>';
      }
    });
  });

  /* APPLY BUTTON → SCROLL TO RESUME SECTION */
  document.querySelectorAll('.apply-btn').forEach((button) => {
    button.addEventListener('click', () => {
      const target = button.getAttribute('data-apply');
      const resumeSection = document.getElementById(target || '');
      if (!resumeSection) return;

      resumeSection.classList.add('active');
      resumeSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  /* RESUME FILE INPUT → SHOW FILENAME */
  document.querySelectorAll('.resume-input').forEach((input) => {
    input.addEventListener('change', () => {
      const resumeSection = input.closest('.resume-section');
      if (!resumeSection) return;

      const fileDisplay = resumeSection.querySelector('.selected-file');
      const applicationForm = resumeSection.querySelector('.application-form');
      const file = (input as HTMLInputElement).files?.[0];

      if (!file) {
        if (fileDisplay) fileDisplay.textContent = '';
        if (applicationForm) applicationForm.classList.remove('active');
        return;
      }

      if (fileDisplay) fileDisplay.textContent = `✓ ${file.name}`;
      if (applicationForm) applicationForm.classList.add('active');
    });
  });

  /* SUBMIT APPLICATION → POST TO /api/apply */
  document.querySelectorAll('.submit-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const resumeSection = button.closest('.resume-section');
      if (!resumeSection) return;

      const resumeInput = resumeSection.querySelector('.resume-input');
      const file = (resumeInput as HTMLInputElement).files?.[0];

      const nameInput = resumeSection.querySelector<HTMLInputElement>(
        'input[id$="-name"]'
      );
      const emailInput = resumeSection.querySelector<HTMLInputElement>(
        'input[id$="-email"]'
      );
      const phoneInput = resumeSection.querySelector<HTMLInputElement>(
        'input[id$="-phone"]'
      );
      const roleInput = resumeSection.querySelector<HTMLInputElement>(
        'input[id$="-role"]'
      );
      const linkedinInput = resumeSection.querySelector<HTMLInputElement>(
        'input[id$="-linkedin"]'
      );
      const portfolioInput = resumeSection.querySelector<HTMLInputElement>(
        'input[id$="-portfolio"]'
      );
      const jobIdInput = resumeSection.querySelector<HTMLInputElement>(
        'input[name="job_id"]'
      );

      const message = resumeSection.querySelector('.submit-message');

      if (!file) {
        if (message) {
          message.textContent = 'Please upload your resume.';
          message.className = 'submit-message error';
        }
        return;
      }

      if (
        !nameInput?.value.trim() ||
        !emailInput?.value.trim() ||
        !roleInput?.value.trim()
      ) {
        if (message) {
          message.textContent = 'Please fill in the required details.';
          message.className = 'submit-message error';
        }
        return;
      }

      const formData = new FormData();
      formData.append('resume', file);
      formData.append('name', nameInput.value.trim());
      formData.append('email', emailInput.value.trim());
      formData.append('phone', phoneInput?.value.trim() || '');
      formData.append('role', roleInput.value.trim());
      formData.append('linkedin', linkedinInput?.value.trim() || '');
      formData.append('portfolio', portfolioInput?.value.trim() || '');

      // Pass the real database job_id
      if (jobIdInput?.value) {
        formData.append('job_id', jobIdInput.value);
      }

      const originalText = button.innerHTML;
      (button as HTMLButtonElement).disabled = true;
      button.innerHTML = 'Submitting...';
      if (message) message.textContent = '';

      try {
        const response = await fetch('/api/apply', {
          method: 'POST',
          body: formData,
        });
        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Application submission failed');
        }

        if (message) {
          message.textContent = '✓ Application submitted successfully.';
          message.className = 'submit-message success';
        }
        button.innerHTML = 'Application Submitted ✓';
        (button as HTMLButtonElement).disabled = true;
      } catch (error) {
        if (message) {
          message.textContent =
            error instanceof Error
              ? error.message
              : 'Something went wrong. Please try again.';
          message.className = 'submit-message error';
        }
        (button as HTMLButtonElement).disabled = false;
        button.innerHTML = originalText;
      }
    });
  });
</script>
