---
import { INDUSTRY_DETAILS } from '../../data/industries';
---
<section class="page-section explorer"><div class="wrap"><div class="section-intro rv"><span class="eyebrow">Industry Explorer</span><h2>Choose a system context.</h2><p>Hover or tap an industry to bring its workflow into focus.</p></div><div class="industry-explorer"><div class="industry-list">{INDUSTRY_DETAILS.map((item,i) => <button class="industry-item rv" type="button" data-slug={item.slug} data-title={item.title} data-text={item.short} aria-pressed="false"><span>0{i+1}</span><strong>{item.title}</strong><em>View More →</em></button>)}</div><div class="industry-preview rv" id="industry-preview" aria-live="polite"><span>01</span><h3>{INDUSTRY_DETAILS[0].title}</h3><p>{INDUSTRY_DETAILS[0].short}</p><a class="btn k" href={`/industries/${INDUSTRY_DETAILS[0].slug}`}>View More</a></div></div></div></section><script>
const items=[...document.querySelectorAll<HTMLButtonElement>('.industry-item')]; const panel=document.querySelector<HTMLElement>('#industry-preview'); const select=(b:HTMLButtonElement)=>{items.forEach(x=>x.setAttribute('aria-pressed',String(x===b))); items.forEach(x=>x.classList.toggle('muted',x!==b)); if(panel){panel.innerHTML=`<span>${b.querySelector('span')?.textContent||''}</span><h3>${b.dataset.title||''}</h3><p>${b.dataset.text||''}</p><a class="btn k" href="/industries/${b.dataset.slug}">View More</a>`; panel.classList.remove('panel-in'); requestAnimationFrame(()=>panel.classList.add('panel-in'));}}; items.forEach(b=>{b.addEventListener('mouseenter',()=>select(b));b.addEventListener('focus',()=>select(b));b.addEventListener('click',()=>select(b));}); if(items[0]) select(items[0]);
</script>