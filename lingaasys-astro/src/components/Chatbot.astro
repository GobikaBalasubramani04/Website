<div class="bot" id="bot">
  <div class="bot-panel" id="bot-panel" role="dialog" aria-label="Lingaasys assistant chat">
    <div class="bot-head"><span>Lingaasys Assistant</span><button class="bot-x" type="button" aria-label="Close chat">×</button></div>
    <div class="bot-msgs" id="bot-msgs" aria-live="polite"><div class="bm b">Hello! I'm the Lingaasys assistant. Ask me about our work.</div></div>
    <form class="bot-form" id="bot-form"><input type="text" name="q" placeholder="Type a message" aria-label="Message" autocomplete="off" /><button type="submit">Send</button></form>
  </div>
  <button class="bot-btn" type="button" id="bot-btn" aria-label="Open chat" aria-expanded="false" aria-controls="bot-panel">
