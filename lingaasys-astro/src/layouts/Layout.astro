---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'Lingaasys — Creating Systems for Humanity', description = 'Lingaasys builds thoughtful technology, software, and systems.' } = Astro.props;
---
<!doctype html>
<html lang="en"><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title><meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <noscript><style>.rv,.hw{opacity:1!important;transform:none!important}</style></noscript>
</head><body><slot /><script>import '../scripts/reveal';</script></body></html>
